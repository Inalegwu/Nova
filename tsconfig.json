{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "strict": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"],
      "@state": ["./src/web/state/index.ts"],
      "@web/*": ["./src/web/*"],
      "@core/*": ["./src/shared/core/*"],
      "@renderer": ["./src/shared/core/renderer/index.ts"],
      "@atoms": ["./src/web/components/atoms/index.ts"],
      "@components": ["./src/web/components/index.ts"],
      "@channels": ["./src/shared/channels/index.ts"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "quickinfo": true,
        "completions": true,
        "refactors": true
      }
    ]
  },
  "include": ["src"]
}
